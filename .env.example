# ─────────────────────────────────────────────────────────────────────────
# DSA Quest — environment variables
# Copy this file to `.env` and fill in the values you need.
# ─────────────────────────────────────────────────────────────────────────

# REQUIRED — PostgreSQL connection string.
# Local Docker (see docker-compose.yml):
DATABASE_URL="postgresql://dsaquest:dsaquest@localhost:5432/dsaquest?schema=public"
# Managed Postgres (Neon/Supabase/Railway/RDS) — get this from your provider's dashboard:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# REQUIRED — used to sign session cookies (JWT). Generate a strong random
# value, e.g.: `openssl rand -base64 32`
JWT_SECRET="replace-with-a-long-random-string"

# REQUIRED for the AI mentor (Sage) — hint/Socratic/debug/complexity/interview modes.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=""
# Optional — override the default model.
# ANTHROPIC_MODEL="claude-sonnet-5"

# OPTIONAL but STRONGLY RECOMMENDED for production — sandboxed code execution
# via Judge0 (https://github.com/judge0/judge0). Without this set, the app
# falls back to an in-process "demo mode" runner (src/lib/execution/demoRunner.ts)
# that is convenient for local development but is NOT securely sandboxed and
# must not be exposed to untrusted users in production.
#
# Option A — self-hosted Judge0 (see docker-compose.yml, `judge0` profile):
# JUDGE0_API_URL="http://localhost:2358"
#
# Option B — Judge0 via RapidAPI (https://rapidapi.com/judge0-official/api/judge0-ce):
# JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
# JUDGE0_API_KEY="your-rapidapi-key"
# JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"
